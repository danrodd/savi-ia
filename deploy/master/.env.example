# Copiar a .env y completar:  cp .env.example .env     (o dejar que ./setup.sh lo haga)
# Los secretos NO van acá: viven en ./secrets (ver setup.sh y DEPLOYMENT.md).

# ── Versiones fijas de las imágenes de terceros ──────────────────────
# Verificar la última estable antes de cambiarlas.
POSTGRES_VERSION=16.6-alpine
CADDY_VERSION=2.8.4-alpine

# ── Zona horaria ─────────────────────────────────────────────────────
TZ=America/Bogota

# ── Dominios públicos (los registros DNS tipo A deben apuntar a este servidor) ──
# SAVI (chat y administración) y SAVI Cloud (consola del equipo de SEO).
SAVI_DOMAIN=savi.example.com
CLOUD_DOMAIN=cloud.example.com
# Correo para el certificado de Let's Encrypt (avisos de vencimiento).
ACME_EMAIL=admin@example.com

# ── Bases de datos (solo nombres; las contraseñas son archivos en ./secrets) ──
SAVI_DB_USER=savi
SAVI_DB_NAME=savi_agente
CLOUD_DB_USER=savi_cloud
CLOUD_DB_NAME=savi_cloud

# ── SAVI ─────────────────────────────────────────────────────────────
# Códigos de usuario del ERP con acceso a Administración aunque no sean admin del ERP,
# separados por coma. Vacío = solo los administradores del ERP.
SAVI_ADMIN_LOGINS=
# Segundo factor (TOTP): `admins` (recomendado), `all` o `off`. Con `admins`, los administradores
# configuran una aplicación de autenticación en su primer ingreso.
SAVI_MFA_ENFORCEMENT=admins
# Nombre que muestra la aplicación de autenticación junto al código.
SAVI_MFA_ISSUER="SAVI Master"
# Vincular este SAVI con el Cloud de este mismo servidor (opcional). Debe ser https:
#   SAVI_CLOUD_URL=https://cloud.example.com
SAVI_CLOUD_URL=

# ── SAVI Cloud ───────────────────────────────────────────────────────
CLOUD_LOG_LEVEL=INFO
CLOUD_ENROLLMENT_TOKEN_TTL_HOURS=72
# Última versión publicada de SAVI y cuándo (ISO 8601). Sin la fecha no se alerta por
# instancias desactualizadas.
CLOUD_LATEST_VERSION=
CLOUD_LATEST_VERSION_PUBLISHED_AT=

# ── Generadas por setup.sh en cada ejecución (no editar) ─────────────
SAVI_VERSION=
SAVI_COMMIT=
SAVI_BUILT_AT=
