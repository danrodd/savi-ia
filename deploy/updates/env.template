# Plantilla del .env de este despliegue. ./setup.sh la copia a .env la primera vez.
# No hay secretos: la clave privada que firma las versiones nunca sale del equipo de publicación.

# ── Versión fija de Caddy ───────────────────────────────────────────
CADDY_VERSION=2.8.4-alpine
TZ=America/Bogota

# ── Dirección del sitio ──────────────────────────────────────────────
# Modo directo (Caddy atiende los puertos 80 y 443 y saca el certificado):
#   UPDATES_SITE=updates.example.com
# Detrás de otro proxy que ya tiene el 80 y el 443 (nginx, otro Caddy): ese proxy pone el
# HTTPS y le pasa el tráfico a este contenedor por HTTP:
#   UPDATES_SITE=http://updates.example.com
UPDATES_SITE=updates.example.com
# Correo para el certificado de Let's Encrypt (avisos de vencimiento). Obligatorio, aunque
# detrás de otro proxy no se use.
ACME_EMAIL=admin@example.com

# ── Puertos del servidor ─────────────────────────────────────────────
# Modo directo: 0.0.0.0, 80 y 443 (Let's Encrypt necesita esos puertos desde afuera).
# Detrás de otro proxy: 127.0.0.1 y puertos libres, por ejemplo 8088 y 8448.
UPDATES_BIND=0.0.0.0
UPDATES_HTTP_PORT=80
UPDATES_HTTPS_PORT=443

# ── Carpeta publicada ────────────────────────────────────────────────
# Las instalaciones leen https://<dominio>/savi/<canal>.json, así que savi-publish sube a
# $UPDATES_DIR/savi. Fuera del repositorio, para que un `git pull` no la toque.
UPDATES_DIR=/srv/savi-updates
# Usuario de Linux que publica por SSH. Solo puede escribir en $UPDATES_DIR/savi.
UPDATES_PUBLISH_USER=savi-publish
