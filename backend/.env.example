APP_NAME=SAVI
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

AGENT_DB_HOST=localhost
AGENT_DB_PORT=5433
AGENT_DB_USER=postgres
AGENT_DB_PASSWORD=changeme
AGENT_DB_NAME=savi_agente

# Semilla de la base del ERP por defecto. El resto de los clientes se
# administran desde la app (seccion Administracion).
ERP_DB_HOST=localhost
ERP_DB_PORT=5432
ERP_DB_USER=postgres
ERP_DB_PASSWORD=changeme
ERP_DB_NAME=farmacias_similares
ERP_DB_STATEMENT_TIMEOUT_MS=60000

# Clave Fernet para cifrar las contrasenas de conexion de las bases del
# ERP. Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Perderla deja ilegibles todas las contrasenas guardadas.
ERP_CREDENTIALS_KEY=
ERP_CREDENTIALS_KEY_OLD=
ERP_MAX_OPEN_ENGINES=10

# Codigos (Seguridad.Usuario.codigo) con acceso a Administracion aunque
# no sean admin en el ERP. Separados por coma. Vacio por defecto.
SAVI_ADMIN_LOGINS=

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_TITLE_MODEL=claude-haiku-4-5
CLAUDE_CODE_GIT_BASH_PATH=C:/Program Files/Git/bin/bash.exe
MAX_RESPONSE_CHARS=20000
MAX_AGENT_TURNS=40
TITLE_PHASE2_TIMEOUT_S=4.0

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Límites de pedidos. Los defaults son holgados: un usuario de la app de
# escritorio no los toca nunca y frenan a un script. `false` los apaga (los
# E2E lo usan).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
# Contraseñas malas seguidas antes de bloquear ese login, y por cuánto.
RATE_LIMIT_LOGIN_MAX_FAILURES=5
RATE_LIMIT_LOGIN_BLOCK_MINUTES=15
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_HOUR=200
RATE_LIMIT_UPLOAD_PER_HOUR=30
RATE_LIMIT_GLOBAL_PER_MINUTE=300
# Solo activar detrás de un proxy propio: confiar en `X-Forwarded-For` sin
# uno deja que cualquiera invente su IP y esquive los límites.
TRUST_PROXY_HEADERS=false

# Turnos de chat simultáneos. Cada uno levanta un subproceso del CLI con su
# contexto; sin tope, varios usuarios a la vez agotan la memoria del equipo.
MAX_CONCURRENT_CHAT_TURNS=3
# Reloj de pared por turno. MAX_AGENT_TURNS acota las rondas de herramienta,
# no el tiempo.
CHAT_TURN_TIMEOUT_SECONDS=180

# Conocimiento de la empresa (documentos propios del cliente). El modelo
# de embeddings viaja en el instalador; en desarrollo se baja con
# `uv run download-embedding-model` a backend/.models/.
COMPANY_DOCS_MAX_FILE_MB=20
COMPANY_DOCS_MAX_PAGES=500
COMPANY_DOCS_MAX_CHUNKS_PER_DOC=2000
COMPANY_DOCS_MAX_TOTAL_CHUNKS=50000
COMPANY_DOCS_CHUNK_TOKENS=900
COMPANY_DOCS_CHUNK_OVERLAP=120
COMPANY_DOCS_EMBEDDING_MODEL=intfloat/multilingual-e5-small
COMPANY_DOCS_MODEL_DIR=
COMPANY_DOCS_WORKER_ENABLED=true
COMPANY_DOCS_MIN_SIMILARITY=0.80
COMPANY_DOCS_SEARCH_CANDIDATES=50
COMPANY_DOCS_SEARCH_LIMIT=6
COMPANY_DOCS_SEARCH_MAX_PER_DOCUMENT=3
COMPANY_DOCS_MAX_CONTEXT_CHARS=6000
