# ─────────────────────────────────────────────────────────────────────
# Secrets / env
# ─────────────────────────────────────────────────────────────────────
# Por defecto NINGÚN .env se sube. Whitelist explícito al final.
.env
.env.*
.env.local
.env.*.local

# Whitelist: plantillas públicas SÍ se versionan.
!.env.example
!.env.sample


# ─────────────────────────────────────────────────────────────────────
# Python / backend
# ─────────────────────────────────────────────────────────────────────
__pycache__/
# Versión incrustada por installer/build.ps1 (ver backend/app/_version.py).
backend/app/_build_version.py
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.basedpyright/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/
.ipynb_checkpoints/
dist/
build/
*.egg-info/
pip-wheel-metadata/

# ─────────────────────────────────────────────────────────────────────
# Node / frontend
# ─────────────────────────────────────────────────────────────────────
node_modules/
.next/
.turbo/
.swc/
out/
.pnpm-store/
.yarn/cache/
.yarn/install-state.gz
.parcel-cache/
*.tsbuildinfo
next-env.d.ts.tmp

# pnpm 11 RC genera este workspace.yaml vacío sin valores útiles.
frontend/pnpm-workspace.yaml

# ─────────────────────────────────────────────────────────────────────
# IDE / editores
# ─────────────────────────────────────────────────────────────────────
.vscode/
!.vscode/settings.json.example
.idea/
*.iml
*.swp
*.swo
*~
.history/

# ─────────────────────────────────────────────────────────────────────
# Claude Code (worktrees, cache, sesiones internas)
# ─────────────────────────────────────────────────────────────────────
.claude/
.agents/
# Cache de skill-registry (generado por la skill `skill-registry`).
.atl/

# ─────────────────────────────────────────────────────────────────────
# OS leftover
# ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ─────────────────────────────────────────────────────────────────────
# Logs y outputs temporales
# ─────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─────────────────────────────────────────────────────────────────────
# Datos locales / artefactos / backups
# ─────────────────────────────────────────────────────────────────────
data/
# Excepción: el catálogo de conocimiento vive en un directorio llamado
# `data/`, así que la regla de arriba lo ignoraba entero — por eso nunca
# llegó al repositorio. Sí tiene que versionarse: el diseño del módulo
# asume que "los archivos viajan en el repo y los cambios se aplican por
# deploy" (knowledge/infrastructure/catalog_provider.py).
!backend/app/modules/knowledge/data/
!backend/app/modules/knowledge/data/**

*.sqlite
*.sqlite3
*.db
*.db-journal
# WAL de SQLite (la BD del agente en instalación de escritorio).
*.db-wal
*.db-shm
*.bak
*.tmp
*.old

# Análisis de la BD del cliente con samples reales (PII). NUNCA versionar:
# el mapa derivado y sanitizado vive en backend/docs/, no acá.
backend/scripts/db_analysis/

# Paquetes / instaladores que no deberían vivir en el repo.
*.deb
*.rpm
*.msi
*.dmg
*.exe
*.dll
*.pdb

# Archivos comprimidos generados (descargas temporales).
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Cachés de modelos de ML / embeddings si alguien los redirige al repo
# (por defecto viven en ~/.cache/orf-aniro/fastembed/ — fuera del repo).
.cache/
.fastembed_cache/


# PM2 runtime (logs, pids) — pero NO el ecosystem.config.js que sí va al repo.
.pm2/
*.pid

# ─────────────────────────────────────────────────────────────────────
# Empaquetado del instalador de escritorio
# ─────────────────────────────────────────────────────────────────────
# Staging del build de Vue que consume el backend (lo genera build.ps1).
backend/frontend/
# Salida de PyInstaller y del compilador de Inno Setup.
installer/build/
installer/output/
# Prerrequisitos descargados en tiempo de build (Node, git-bash).
installer/vendor/
