# Configuracion de SAVI - generada por el instalador.
# Los valores entre {{llaves}} los reemplaza el asistente de instalacion.
# Sirve tambien como plantilla para un despliegue manual: copialo como
# backend/.env y completa los valores.
#
# NOTA PARA QUIEN EDITE ESTE ARCHIVO: mantenerlo en ASCII, sin tildes ni
# enies. Inno Setup no tiene un cargador UTF-8 (LoadStringsFromFile lee
# en la codepage del sistema), asi que cualquier caracter no ASCII que
# viva en la plantilla se corrompe al generar el .env. Los valores que
# escribe el usuario en el asistente si se guardan como UTF-8: se leen
# de la interfaz, no de este archivo.

# -- Aplicacion --------------------------------------------------------
APP_NAME=SAVI
APP_ENV=production
APP_DEBUG=false
# 127.0.0.1 a proposito: con 0.0.0.0 el equipo publicaria en toda la red
# un agente con acceso de lectura al ERP.
APP_HOST=127.0.0.1
APP_PORT={{APP_PORT}}

# -- Base de datos de SAVI (conversaciones, mensajes, sesiones) ---------
# sqlite     -> un archivo local, sin servidor que administrar.
# postgresql -> exige AGENT_DB_HOST/PORT/USER/PASSWORD/NAME.
AGENT_DB_ENGINE={{AGENT_DB_ENGINE}}
# Vacio resuelve a %LOCALAPPDATA%\SAVI\savi.db en tiempo de ejecucion.
# Fijar la ruta en la instalacion la ata al perfil de quien instalo, que
# en una empresa suele ser una cuenta de administrador distinta de la
# del usuario final.
AGENT_DB_PATH={{AGENT_DB_PATH}}
AGENT_DB_HOST={{AGENT_DB_HOST}}
AGENT_DB_PORT={{AGENT_DB_PORT}}
AGENT_DB_USER={{AGENT_DB_USER}}
AGENT_DB_PASSWORD={{AGENT_DB_PASSWORD}}
AGENT_DB_NAME={{AGENT_DB_NAME}}

# -- Base de datos del ERP (semilla de la BD por defecto) --------------
# Estos valores siembran la PRIMERA base del ERP la primera vez que
# arranca SAVI, y quedan como la base por defecto. A partir de ahi las
# demas bases de clientes se administran desde la aplicacion (seccion
# Administracion), sin tocar este archivo ni reinstalar.
ERP_DB_HOST={{ERP_DB_HOST}}
ERP_DB_PORT={{ERP_DB_PORT}}
ERP_DB_USER={{ERP_DB_USER}}
ERP_DB_PASSWORD={{ERP_DB_PASSWORD}}
ERP_DB_NAME={{ERP_DB_NAME}}
ERP_DB_STATEMENT_TIMEOUT_MS=60000

# -- Cifrado de credenciales de las bases del ERP ----------------------
# Clave Fernet (32 bytes en base64 url-safe) con la que se cifran las
# contrasenas de conexion de todas las bases registradas. La genera el
# instalador, al azar, una vez por instalacion.
#
# IMPORTANTE: si se pierde o se cambia, TODAS las contrasenas guardadas
# quedan ilegibles y hay que volver a ingresarlas desde Administracion.
# Es la clave a preservar en una reinstalacion, junto con la BD savi.db.
ERP_CREDENTIALS_KEY={{ERP_CREDENTIALS_KEY}}
# Solo durante una rotacion de clave: la clave anterior. Vacia el resto
# del tiempo.
ERP_CREDENTIALS_KEY_OLD=
# Tope de conexiones a bases del ERP vivas a la vez (eviccion LRU).
ERP_MAX_OPEN_ENGINES=10

# -- Administracion de SAVI --------------------------------------------
# Codigos de usuario (Seguridad.Usuario.codigo) separados por coma que
# reciben acceso a la seccion de Administracion aunque NO sean
# administradores en el ERP. Un administrador del ERP ya tiene acceso por
# su propio flag; esto es solo el escape para los que no lo son. Solo
# habilita esa seccion: no otorga modulos del ERP ni cambia que datos
# puede consultar el usuario.
SAVI_ADMIN_LOGINS={{SAVI_ADMIN_LOGINS}}

# -- Claude ------------------------------------------------------------
# Metodo preferido: token de Claude Code (generado con: claude setup-token).
# No depende de administrar una clave de API. Si se deja vacio, se usa
# ANTHROPIC_API_KEY; si esa tambien esta vacia, se usa una sesion local
# de "claude login" si existe en este equipo.
CLAUDE_CODE_OAUTH_TOKEN={{CLAUDE_CODE_OAUTH_TOKEN}}
ANTHROPIC_API_KEY={{ANTHROPIC_API_KEY}}
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_TITLE_MODEL=claude-haiku-4-5
# El SDK lanza el binario `claude` como subproceso; en Windows necesita
# el bash que trae Git for Windows.
CLAUDE_CODE_GIT_BASH_PATH={{GIT_BASH_PATH}}
MAX_RESPONSE_CHARS=20000
MAX_AGENT_TURNS=40
TITLE_PHASE2_TIMEOUT_S=4.0

# -- Consulta SQL libre ------------------------------------------------
FREE_QUERY_MAX_ROWS=50
FREE_QUERY_MAX_ESTIMATED_ROWS=1000

# -- Auth --------------------------------------------------------------
# Generado al azar por instalacion. Cambiarlo invalida las sesiones
# abiertas, nada mas.
JWT_SECRET={{JWT_SECRET}}
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
JWT_ISSUER=savi

# -- CORS --------------------------------------------------------------
# Vacio a proposito: el frontend se sirve desde el mismo origen que el
# API, asi que no hay peticion cross-origin que permitir.
CORS_ALLOWED_ORIGINS=

# -- Reportes de consumo -----------------------------------------------
USD_TO_COP_RATE=4000
REPORTING_TIMEZONE=America/Bogota
