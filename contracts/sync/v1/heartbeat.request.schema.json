{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://savi.seo/contracts/sync/v1/heartbeat.request.schema.json",
  "title": "POST /api/v1/instances/heartbeat - request",
  "type": "object",
  "required": ["sent_at", "fingerprint", "version", "deployment_mode"],
  "properties": {
    "sent_at": { "$ref": "#/$defs/datetime" },
    "fingerprint": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "type": ["string", "null"], "maxLength": 64 },
    "commit": { "type": ["string", "null"], "maxLength": 64 },
    "deployment_mode": { "enum": ["server", "desktop"] },
    "started_at": { "oneOf": [{ "$ref": "#/$defs/datetime" }, { "type": "null" }] },
    "tls": { "type": ["boolean", "null"] },
    "llm": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "provider": { "type": ["string", "null"], "maxLength": 64 },
            "model": { "type": ["string", "null"], "maxLength": 128 },
            "credential_kind": { "type": ["string", "null"], "maxLength": 64 },
            "usable": { "type": ["boolean", "null"] }
          }
        }
      ]
    },
    "erp_databases": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "usable": { "type": "integer", "minimum": 0 },
            "credentials_unreadable": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "active_sessions": { "type": ["integer", "null"], "minimum": 0 },
    "sync": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "streams": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "watermark_at": { "oneOf": [{ "$ref": "#/$defs/datetime" }, { "type": "null" }] },
                  "last_ok_at": { "oneOf": [{ "$ref": "#/$defs/datetime" }, { "type": "null" }] }
                }
              }
            },
            "last_error": { "type": ["string", "null"], "maxLength": 64 }
          }
        }
      ]
    },
    "warnings": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" }
    }
  },
  "$defs": {
    "datetime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
