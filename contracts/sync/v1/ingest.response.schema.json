{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://savi.seo/contracts/sync/v1/ingest.response.schema.json",
  "title": "POST /api/v1/instances/ingest - response 200",
  "type": "object",
  "required": ["accepted", "duplicates", "rejected"],
  "properties": {
    "accepted": { "type": "integer", "minimum": 0 },
    "duplicates": { "type": "integer", "minimum": 0 },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "reason"],
        "properties": {
          "source_id": { "type": "string", "maxLength": 128 },
          "reason": { "enum": ["unknown_schema", "invalid_event"] }
        }
      }
    }
  }
}
