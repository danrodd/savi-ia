{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://savi.seo/contracts/sync/v1/events/turn.schema.json",
  "title": "Evento turn/1 - un turno del asistente",
  "type": "object",
  "required": ["schema", "source_id", "occurred_at", "data"],
  "properties": {
    "schema": { "const": "turn/1" },
    "source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_ref",
        "user_ref",
        "input_tokens",
        "output_tokens",
        "cache_read_input_tokens",
        "cache_creation_input_tokens"
      ],
      "properties": {
        "conversation_ref": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "database_ref": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "user_ref": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "provider": { "type": ["string", "null"], "maxLength": 64 },
        "model": { "type": ["string", "null"], "maxLength": 128 },
        "finish_reason": { "type": ["string", "null"], "maxLength": 64 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_input_tokens": { "type": "integer", "minimum": 0 },
        "cache_creation_input_tokens": { "type": "integer", "minimum": 0 },
        "cost_usd": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{1,6}(\\.[0-9]{1,6})?$"
        },
        "tools": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 100 },
              "status": { "type": "string", "minLength": 1, "maxLength": 32 },
              "tipo": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" }
            }
          }
        },
        "latency_ms": { "type": ["integer", "null"], "minimum": 0 },
        "action": { "enum": ["send", "edit_last", "regenerate", null] }
      }
    }
  }
}
