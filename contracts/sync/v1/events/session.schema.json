{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://savi.seo/contracts/sync/v1/events/session.schema.json",
  "title": "Evento session/1 - inicio de sesion",
  "type": "object",
  "required": ["schema", "source_id", "occurred_at", "data"],
  "properties": {
    "schema": { "const": "session/1" },
    "source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_ref"],
      "properties": {
        "user_ref": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "database_ref": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      }
    }
  }
}
