{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://savi.seo/contracts/sync/v1/events/free_query.schema.json",
  "title": "Evento free_query/1 - consulta libre (solo metricas, nunca el SQL)",
  "type": "object",
  "required": ["schema", "source_id", "occurred_at", "data"],
  "properties": {
    "schema": { "const": "free_query/1" },
    "source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result"],
      "properties": {
        "conversation_ref": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "database_ref": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "result": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$" },
        "estimated_rows": { "type": ["integer", "null"], "minimum": 0 },
        "returned_rows": { "type": ["integer", "null"], "minimum": 0 },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
