{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://savi.seo/contracts/sync/v1/events/database.schema.json",
  "title": "Evento database/1 - inventario de sucursales (snapshot diario)",
  "type": "object",
  "required": ["schema", "source_id", "occurred_at", "data"],
  "properties": {
    "schema": { "const": "database/1" },
    "source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database_ref",
        "code",
        "name",
        "is_active",
        "is_usable",
        "credentials_unreadable"
      ],
      "properties": {
        "database_ref": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "code": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "is_active": { "type": "boolean" },
        "is_usable": { "type": "boolean" },
        "credentials_unreadable": { "type": "boolean" },
        "last_connection_ok_at": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      }
    }
  }
}
