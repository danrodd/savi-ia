{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://savi.seo/contracts/sync/v1/enroll.response.schema.json",
  "title": "POST /api/v1/enrollments/redeem - response 201",
  "type": "object",
  "required": ["instance_id", "instance_secret", "client", "policy"],
  "properties": {
    "instance_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "instance_secret": { "type": "string", "pattern": "^svk_ins_[0-9A-Za-z]{43}$" },
    "client": {
      "type": "object",
      "required": ["id", "code", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "code": { "type": "string", "minLength": 2, "maxLength": 32 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "policy": { "$ref": "#/$defs/policy" }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "required": ["heartbeat_seconds", "ingest_seconds", "max_batch_events", "sync_enabled"],
      "properties": {
        "heartbeat_seconds": { "type": "integer", "minimum": 1 },
        "ingest_seconds": { "type": "integer", "minimum": 1 },
        "max_batch_events": { "type": "integer", "minimum": 1, "maximum": 500 },
        "sync_enabled": { "type": "boolean" },
        "config_locked": { "type": "boolean" },
        "allow_local_cli": { "type": "boolean" },
        "access": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "default_databases": {
              "type": ["array", "null"],
              "maxItems": 200,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
            },
            "user_databases": {
              "type": "object",
              "maxProperties": 500,
              "propertyNames": { "pattern": "^[0-9a-f]{32}$" },
              "additionalProperties": {
                "type": "array",
                "maxItems": 200,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
              }
            }
          }
        },
        "ai": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "allowed_providers": {
              "type": ["array", "null"],
              "items": { "enum": ["claude", "gemini", "openai"] },
              "uniqueItems": true
            },
            "user_monthly_usd": { "type": ["string", "null"], "pattern": "^[0-9]{1,8}(\\.[0-9]{1,4})?$" },
            "provider_monthly_usd": {
              "type": "object",
              "propertyNames": { "enum": ["claude", "gemini", "openai"] },
              "additionalProperties": { "type": "string", "pattern": "^[0-9]{1,8}(\\.[0-9]{1,4})?$" }
            },
            "user_overrides": {
              "type": "object",
              "maxProperties": 500,
              "propertyNames": { "pattern": "^[0-9a-f]{32}$" },
              "additionalProperties": { "type": "string", "pattern": "^[0-9]{1,8}(\\.[0-9]{1,4})?$" }
            }
          }
        },
        "identity_mode": { "enum": ["pseudonym", "named"] }
      }
    }
  }
}
