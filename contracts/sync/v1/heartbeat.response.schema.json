{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://savi.seo/contracts/sync/v1/heartbeat.response.schema.json",
  "title": "POST /api/v1/instances/heartbeat - response 200",
  "type": "object",
  "required": ["server_time", "instance_status", "policy", "notices"],
  "properties": {
    "server_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "instance_status": { "enum": ["active", "suspended", "revoked"] },
    "policy": {
      "type": "object",
      "required": ["heartbeat_seconds", "ingest_seconds", "max_batch_events", "sync_enabled"],
      "properties": {
        "heartbeat_seconds": { "type": "integer", "minimum": 1 },
        "ingest_seconds": { "type": "integer", "minimum": 1 },
        "max_batch_events": { "type": "integer", "minimum": 1, "maximum": 500 },
        "sync_enabled": { "type": "boolean" },
        "config_locked": { "type": "boolean" },
        "identity_mode": { "enum": ["pseudonym", "named"] }
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
          "severity": { "enum": ["info", "warning", "critical"] },
          "message": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "ai": { "type": ["object", "null"] }
  }
}
