{
	email {$ACME_EMAIL}
}

{$SAVI_CLOUD_DOMAIN} {
	encode zstd gzip

	# Caddy omite por defecto Authorization y Cookie en sus logs (log_credentials desactivado).
	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# `ingest` acepta lotes con gzip: se limita el tamaño del cuerpo.
	request_body {
		max_size 10MB
	}

	reverse_proxy api:8000 {
		health_uri /health
		health_interval 15s
	}
}
