# SAVI Cloud: copiar a `.env` y completar. `.env` NO se versiona.

# Dominio público (el registro DNS A debe apuntar a este servidor).
SAVI_CLOUD_DOMAIN=cloud.example.com
# Correo para el certificado de Let's Encrypt (avisos de vencimiento).
ACME_EMAIL=admin@example.com

# Contraseña de Postgres. Generar con: openssl rand -hex 24
# (hex evita caracteres especiales que romperían la URL de conexión).
POSTGRES_PASSWORD=CAMBIAR_POR_UN_VALOR_ALEATORIO

# --- Opcionales ---
# CLOUD_LOG_LEVEL=INFO
# CLOUD_ENROLLMENT_TOKEN_TTL_HOURS=72
# Backups: cada cuántas horas y cuántos días se conservan; carpeta del servidor.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP_DAYS=14
# BACKUP_DIR=./backups
